      ],
      "indices": [
        {
          "nombre": "idx_mensajes_conversacion_fecha",
          "campos": {
            "id_conversacion": 1,
            "fecha_hora": -1
          },
          "unico": false
        },
        {
          "nombre": "idx_mensajes_destinatario_fecha",
          "campos": {
