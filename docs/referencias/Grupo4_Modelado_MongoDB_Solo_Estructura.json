          "estado": "string",
          "fecha_solicitud": "date",
          "fecha_generacion": "date|null",
          "parametros": "object{fecha_desde:date|null,fecha_hasta:date|null,id_cliente:uuid_string|null,pais:string|null,estado_envio:string|null}",
          "resultado": "object (resumen, indicadores, filas de ejemplo o ubicación de archivo)",
          "archivo_url": "string|null",
          "error": "string|null"
