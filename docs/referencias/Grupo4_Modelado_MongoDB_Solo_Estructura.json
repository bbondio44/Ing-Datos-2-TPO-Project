          "unico": false
        },
        {
          "nombre": "idx_conversaciones_tipo_estado",
          "campos": {
            "tipo": 1,
            "estado": 1
          },
          "unico": false
        },
        {
          "nombre": "idx_conversaciones_envio",
          "campos": {
            "id_envio": 1
          },
          "unico": false
        }
      ]
    },
    "mensajes": {
      "descripcion": "Mensajería privada, grupal y pública con historial por conversación.",
      "esquema": {
        "campos": {
          "_id": "objectId",
          "id_conversacion": "objectId",
          "id_remitente": "uuid_string",
          "id_destinatario": "uuid_string|null",
          "tipo": "string",
          "fecha_hora": "date",
          "contenido": "string",
          "tipo_contenido": "string",
