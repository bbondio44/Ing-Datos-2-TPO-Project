          "PUBLICO"
        ],
        "tipo_contenido": [
          "TEXTO",
          "ARCHIVO",
          "SISTEMA"
        ],
        "estado": [
          "ENVIADO",
          "EDITADO",
          "ELIMINADO"
        ],
        "id_destinatario": "Requerido en mensaje PRIVADO; null en GRUPAL/PUBLICO."
      },
      "referencias_logicas": [
        "id_conversacion -> MongoDB.conversaciones._id",
        "id_remitente -> PostgreSQL.usuario.id_usuario",
