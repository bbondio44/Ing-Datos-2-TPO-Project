# PostgreSQL local de desarrollo. Para Supabase copie la URL exacta del panel Connect.
POSTGRES_DB=logistica
POSTGRES_USER=logistica
POSTGRES_PASSWORD=change-me
MONGO_USER=logistica
MONGO_PASSWORD=change-me
NEO4J_USER=neo4j

PG_JDBC_URL=jdbc:postgresql://localhost:5432/logistica?sslmode=disable
PG_USERNAME=logistica
PG_PASSWORD=change-me
PG_SCHEMA=tp_logistica

# Active sslmode=require como mínimo en Supabase. Use verify-full y PG_SSL_ROOT_CERT en producción.
PG_SSL_ROOT_CERT=

MONGO_URI=mongodb://logistica:change-me@localhost:27017/logistica_docs?authSource=admin
MONGO_DATABASE=logistica_docs
CASSANDRA_CONTACT_POINTS=127.0.0.1:9042
CASSANDRA_LOCAL_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=logistica_iot
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=logistica_dev_neo4j
NEO4J_DATABASE=neo4j

API_PORT=8080
API_BASE_URL=http://localhost:8080
APP_SESSION_TTL=PT8H
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
