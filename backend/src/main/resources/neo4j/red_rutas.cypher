// Conexiones viejas que saltaban ciudades: ahora el viaje pasa por los puntos intermedios.
MATCH (a:Punto {codigo: 'BUE'})-[r:CONECTA]-(b:Punto {codigo: 'BHI'}) DELETE r;
MATCH (a:Punto {codigo: 'ROS'})-[r:CONECTA]-(b:Punto {codigo: 'COR'}) DELETE r;
MATCH (a:Punto {codigo: 'COR'})-[r:CONECTA]-(b:Punto {codigo: 'TUC'}) DELETE r;
MATCH (a:Punto {codigo: 'SFE'})-[r:CONECTA]-(b:Punto {codigo: 'CRR'}) DELETE r;
MATCH (a:Punto {codigo: 'CRR'})-[r:CONECTA]-(b:Punto {codigo: 'ASU'}) DELETE r;

MATCH (a:Punto {codigo: 'BUE'}), (b:Punto {codigo: 'EZE'}) MERGE (a)-[r:CONECTA {medio: 'TERRESTRE'}]->(b) SET r.km = 35;
