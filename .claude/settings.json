{
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(mvn *)",
      "Bash(./gradlew *)",
      "Bash(gradle *)",
      "Bash(java -version)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(docker compose restart *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(docker compose down *)",
      "Bash(docker volume rm *)",
      "Bash(docker exec *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  }
}
